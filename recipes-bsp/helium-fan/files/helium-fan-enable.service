[Unit]
Description=Helium fan enable (GPIO PAC.06)
Documentation=https://github.com/EstebanSannin/meta-helium
# The fan's power enable must be high before nvfancontrol drives the PWM.
Before=nvfancontrol.service

[Service]
Type=simple
# The image has libgpiod v1: gpiofind maps the line name to "<chip> <offset>",
# and gpioset --mode=signal holds the line until the service stops.
ExecStart=/bin/sh -c 'exec /usr/bin/gpioset --mode=signal $(/usr/bin/gpiofind PAC.06)=1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
